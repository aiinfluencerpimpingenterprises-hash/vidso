{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/youtube/mcp"
    },
    {
      "source": "/youtube",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/connections",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/oauth/:path*"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth/protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth/protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth/authorization-server"
    },
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth/authorization-server"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/oauth/openid-configuration"
    },
    {
      "source": "/preview",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/ui",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/overview",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/clipping",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/ranking",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/image-generation",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/video-generation",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/faceless-studio",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/faceless-studio/:path*",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/api/faceless-studio/:path*",
      "destination": "/api/gate/faceless-studio?p=:path*"
    },
    {
      "source": "/api/gate/:first/:rest*",
      "destination": "/api/gate/:first?p=:rest*"
    },
    {
      "source": "/tools",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/captions",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/voiceover",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/editor",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/reframe",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/downloader",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/files",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/commentary",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/home/index.html"
    },
    {
      "source": "/500",
      "destination": "/500.html"
    },
    {
      "source": "/login",
      "destination": "/auth.html"
    },
    {
      "source": "/signup",
      "destination": "/auth.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/home",
      "permanent": false
    },
    {
      "source": "/landing",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/landing/",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/landing/:path*",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/home",
      "permanent": false
    },
    {
      "source": "/upscale",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/youtube-generation",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/youtube-generation/",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/connectors",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/connectors/",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/upscale/",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/overview",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/overview/",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/analytics",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/analytics/",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/video-generation",
      "permanent": false
    },
    {
      "source": "/dashboard/",
      "destination": "/video-generation",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/auth.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
