{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/overview",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/clipping",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/ranking",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/image-generation",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/video-generation",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/upscale",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/tools",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/captions",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/voiceover",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/editor",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/reframe",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/downloader",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/files",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/commentary",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/home/index.html"
    },
    {
      "source": "/login",
      "destination": "/auth.html"
    },
    {
      "source": "/signup",
      "destination": "/auth.html"
    }
  ],
  "redirects": [
    {
      "source": "/landing",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/landing/",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/landing/:path*",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/home",
      "permanent": false
    },
    {
      "source": "/overview",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/overview/",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/analytics",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/analytics/",
      "destination": "/dashboard",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/auth.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/dashboard/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/pricing",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
